# langchain
OPENAI_API_KEY=
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
RAG_EMBEDDING_QUERY_INSTRUCTION=Given a Korean board game rule question, retrieve the rulebook passage that directly answers the question.
RAG_EMBEDDING_BATCH_SIZE=64

# LLM
# gpt-5.x / o-series는 reasoning 모델이라 temperature 대신 RAG_REASONING_EFFORT를 사용한다.
# 이전 모델(gpt-4o-mini 등)로 롤백하면 RAG_LLM_TEMPERATURE가 적용된다.
RAG_LLM_MODEL=gpt-5.6-luna
RAG_REASONING_EFFORT=none
RAG_LLM_TEMPERATURE=0.3
RAG_RETRIEVE_K=5

LANGCHAIN_TRACING_V2=
LANGCHAIN_ENDPOINT=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

REDIS_URL=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=
RAG_HISTORY_TTL_SECONDS=86400
